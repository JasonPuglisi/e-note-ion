{
  "templates": {
    "today": {
      "schedule": {
        "cron": "0 9 * * *",
        "hold": 600,
        "timeout": 3600
      },
      "priority": 6,
      "truncation": "ellipsis",
      "integration": "calendar",
      "integration_fn": "get_variables_birthdays",
      "templates": [
        {
          "format": [
            "\u2764\ufe0f BIRTHDAYS",
            "{birthdays}"
          ]
        }
      ]
    },
    "self": {
      "schedule": {
        "cron": "0 8 * * *",
        "hold": 3600,
        "timeout": 7200
      },
      "priority": 9,
      "truncation": "word",
      "integration": "calendar",
      "integration_fn": "get_variables_self_birthday",
      "templates": [
        {
          "format": [
            "HAPPY BIRTHDAY",
            "{name}! \u2764\ufe0f"
          ]
        }
      ]
    }
  }
}
