{
  "templates": {
    "conditions": {
      "schedule": {
        "cron": "15 7,12,16 * * *",
        "hold": 600,
        "timeout": 1800,
        "refresh_interval": 1800
      },
      "priority": 5,
      "integration": "diving",
      "templates": [
        {
          "format": [
            "{header}",
            "{swell}",
            "{wind}"
          ]
        }
      ]
    },
    "last_dive": {
      "schedule": {
        "cron": "0 10 * * *",
        "hold": 300,
        "timeout": 3600
      },
      "priority": 3,
      "private": true,
      "integration": "diving",
      "integration_fn": "get_variables_last_dive",
      "templates": [
        {
          "format": [
            "[B] SURFACED",
            "{days_ago}"
          ]
        }
      ]
    }
  }
}
